kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent: {}
  actions:
    - kind: SendActivity
      id: msg_intro02
      activity: |-
        ℹ️ As próximas perguntas se referem ao **CONSULENTE** — a pessoa (física ou jurídica) em cujo nome a consulta será apresentada.

        Se você é contador, advogado ou procurador respondendo por um cliente, responda pensando na situação **do cliente**.

    - kind: ConditionGroup
      id: conditionGroup_tipoPessoa02
      conditions:
        - id: cond_pfpj
          condition: =Global.TipoPessoa = "pf" || Global.TipoPessoa = "pj"
          actions:
            - kind: Question
              id: question_spPfPj
              interruptionPolicy:
                allowInterruption: true

              variable: init:Topic.respostaSujeitoPassivo
              prompt: |-
                O consulente é sujeito passivo de obrigação tributária (principal ou acessória) relacionada ao fato objeto da consulta?

                (Sujeito passivo é quem tem o dever de pagar o tributo — contribuinte ou responsável — ou de cumprir obrigações como reter, declarar ou informar.)
              entity:
                kind: EmbeddedEntity
                definition:
                  kind: ClosedListEntity
                  items:
                    - id: Sim, o consulente é o sujeito passivo
                      displayName: Sim, o consulente é o sujeito passivo

                    - id: Não — o consulente não tem vínculo com o fato
                      displayName: Não — o consulente não tem vínculo com o fato

            - kind: ConditionGroup
              id: conditionGroup_spPfPj
              conditions:
                - id: cond_spPfPjSim
                  condition: =Topic.respostaSujeitoPassivo = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spPfPj'.'Sim, o consulente é o sujeito passivo'
                  actions:
                    - kind: SetVariable
                      id: setVariable_spPfPjTrue
                      variable: Global.SujeitoPassivo
                      value: =true

                - id: cond_spPfPjNao
                  condition: =Topic.respostaSujeitoPassivo = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spPfPj'.'Não — o consulente não tem vínculo com o fato'
                  actions:
                    - kind: Question
                      id: question_spConfirma
                      interruptionPolicy:
                        allowInterruption: true

                      variable: init:Topic.respostaSpConfirma
                      prompt: |-
                        Só para confirmar: o consulente também **não** é responsável ou substituto tributário, nem tem obrigação acessória (reter na fonte, declarar, prestar informação) relacionada a esse fato?

                        Nesses casos, ele TAMBÉM é sujeito passivo e a consulta é possível.
                      entity:
                        kind: EmbeddedEntity
                        definition:
                          kind: ClosedListEntity
                          items:
                            - id: Confirmo — nenhum vínculo, seria consulta de terceiro
                              displayName: Confirmo — nenhum vínculo, seria consulta de terceiro

                            - id: Pensando bem, o consulente tem obrigação ligada ao fato
                              displayName: Pensando bem, o consulente tem obrigação ligada ao fato

                    - kind: ConditionGroup
                      id: conditionGroup_spConfirma
                      conditions:
                        - id: cond_spConfirmaTerceiro
                          condition: =Topic.respostaSpConfirma = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spConfirma'.'Confirmo — nenhum vínculo, seria consulta de terceiro'
                          actions:
                            - kind: SetVariable
                              id: setVariable_motivoNaoSP
                              variable: Global.MotivoBloqueio
                              value: ="nao_sujeito_passivo"

                            - kind: SetVariable
                              id: setVariable_statusNaoSP
                              variable: Global.StatusFluxo
                              value: ="bloqueado_insanavel"

                            - kind: SendActivity
                              id: debug_bloqNaoSP
                              activity: "[DEBUG] StatusFluxo:{Global.StatusFluxo} | MotivoBloqueio:{Global.MotivoBloqueio}"

                            - kind: BeginDialog
                              id: redirect_bloqNaoSP
                              dialog: cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.BLOQ-LegitimidadeMaterial

                        - id: cond_spConfirmaVinculo
                          condition: =Topic.respostaSpConfirma = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spConfirma'.'Pensando bem, o consulente tem obrigação ligada ao fato'
                          actions:
                            - kind: SetVariable
                              id: setVariable_spVinculoTrue
                              variable: Global.SujeitoPassivo
                              value: =true

                            - kind: SendActivity
                              id: msg_spVinculo
                              activity: ✔️ Então o consulente é sujeito passivo (na condição de responsável ou por obrigação acessória) — a triagem pode continuar. Na consulta, descreva esse vínculo com o fato.

        - id: cond_orgao
          condition: =Global.TipoPessoa = "orgao"
          actions:
            - kind: Question
              id: question_spOrgao
              interruptionPolicy:
                allowInterruption: true

              variable: init:Topic.respostaOrgao
              prompt: O órgão público consulente é sujeito passivo da obrigação tributária em questão (por exemplo, como responsável por retenção na fonte), ou a consulta versa sobre situação em que ele não figura como sujeito passivo?
              entity:
                kind: EmbeddedEntity
                definition:
                  kind: ClosedListEntity
                  items:
                    - id: Sim, o órgão é sujeito passivo
                      displayName: Sim, o órgão é sujeito passivo

                    - id: Não — o órgão não figura como sujeito passivo
                      displayName: Não — o órgão não figura como sujeito passivo

            - kind: ConditionGroup
              id: conditionGroup_spOrgao
              conditions:
                - id: cond_orgaoSim
                  condition: =Topic.respostaOrgao = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spOrgao'.'Sim, o órgão é sujeito passivo'
                  actions:
                    - kind: SetVariable
                      id: setVariable_orgaoSim
                      variable: Global.SujeitoPassivo
                      value: =true

                - id: cond_orgaoNaoSP
                  condition: =Topic.respostaOrgao = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spOrgao'.'Não — o órgão não figura como sujeito passivo'
                  actions:
                    - kind: SetVariable
                      id: setVariable_orgaoNaoSP
                      variable: Global.SujeitoPassivo
                      value: =true

                    - kind: SendActivity
                      id: aviso_orgaoNaoSP
                      activity: "⚠️ Atenção: a consulta pode prosseguir, mas, por versar sobre situação em que o órgão não figura como sujeito passivo, os efeitos previstos no art. 18 da IN RFB 2.058/2021 não alcançarão o sujeito passivo da obrigação tributária (art. 23), e a solução terá caráter meramente informativo (art. 27, § 1º)."

        - id: cond_entidade
          condition: =Global.TipoPessoa = "entidade"
          actions:
            - kind: Question
              id: question_spEntidade
              interruptionPolicy:
                allowInterruption: true

              variable: init:Topic.respostaEntidade
              prompt: A consulta é formulada em nome próprio da entidade ou em nome dos associados/filiados?
              entity:
                kind: EmbeddedEntity
                definition:
                  kind: ClosedListEntity
                  items:
                    - id: Em nome próprio da entidade
                      displayName: Em nome próprio da entidade

                    - id: Em nome dos associados, COM autorização expressa
                      displayName: Em nome dos associados, COM autorização expressa

                    - id: Em nome dos associados, SEM autorização expressa
                      displayName: Em nome dos associados, SEM autorização expressa

            - kind: ConditionGroup
              id: conditionGroup_spEntidade
              conditions:
                - id: cond_entidadePropria
                  condition: =Topic.respostaEntidade = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spEntidade'.'Em nome próprio da entidade'
                  actions:
                    - kind: SetVariable
                      id: setVariable_entPropria
                      variable: Global.SujeitoPassivo
                      value: =true

                - id: cond_entidadeComAut
                  condition: =Topic.respostaEntidade = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spEntidade'.'Em nome dos associados, COM autorização expressa'
                  actions:
                    - kind: SetVariable
                      id: setVariable_entComAut
                      variable: Global.SujeitoPassivo
                      value: =true

                    - kind: SendActivity
                      id: lembrete_entAutorizacao
                      activity: "📎 Lembrete: a cópia da autorização expressa (prevista em estatuto ou em documento individual/coletivo dos associados) deverá ser juntada ao processo digital da consulta."

                - id: cond_entidadeSemAut
                  condition: =Topic.respostaEntidade = 'cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.02-LegitimidadeMaterial.main.question_spEntidade'.'Em nome dos associados, SEM autorização expressa'
                  actions:
                    - kind: SetVariable
                      id: setVariable_motivoEntSemAut
                      variable: Global.MotivoBloqueio
                      value: ="entidade_sem_autorizacao"

                    - kind: SetVariable
                      id: setVariable_statusEntSemAut
                      variable: Global.StatusFluxo
                      value: ="bloqueado_insanavel"

                    - kind: SendActivity
                      id: debug_bloqEntSemAut
                      activity: "[DEBUG] StatusFluxo:{Global.StatusFluxo} | MotivoBloqueio:{Global.MotivoBloqueio}"

                    - kind: BeginDialog
                      id: redirect_bloqEntSemAut
                      dialog: cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.BLOQ-LegitimidadeMaterial

    - kind: ConditionGroup
      id: conditionGroup_continuar02
      conditions:
        - id: cond_fluxoAtivo02
          condition: =Global.StatusFluxo = "iniciado"
          actions:
            - kind: SendActivity
              id: debug_final02
              activity: "[DEBUG] SujeitoPassivo:{Global.SujeitoPassivo} | StatusFluxo:{Global.StatusFluxo}"

            - kind: BeginDialog
              id: redirect_topico03
              dialog: cr7f3_AssistentedeAdmissibilidadedeConsulta.topic.03-QuemProtocola

inputType: {}
outputType: {}